{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev",
      "type": "shell",
      "command": "node esbuild.config.js --watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+) - (error|warning) TS(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Build complete|Watching"
        }
      },
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "npm: bundle",
      "type": "shell",
      "command": "node esbuild.config.js --production",
      "group": "build",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "npm: compile (type-check only)",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "group": "build",
      "presentation": { "reveal": "always" }
    }
  ]
}
